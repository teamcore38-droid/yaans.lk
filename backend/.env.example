# Yaans.lk Backend Environment Configuration
PORT=5000
NODE_ENV=development
APP_ENV=development
# Generate a unique random signing key of at least 32 characters. No default is accepted.
JWT_SECRET=
# Independent 32-byte key encoded as base64. Keep it backed up outside Git.
# Production and staging must use different keys. Required for admin authenticator enrollment/login.
MFA_ENCRYPTION_KEY=
# Optional comma-separated, exact browser origins. No wildcard or suffix matching.
CORS_ALLOWED_ORIGINS=

# Customer Google sign-in. Disabled until all settings are supplied.
# Own the Google Cloud OAuth Web application using yaanslk5@gmail.com.
# Never prefix the client secret with VITE_ or commit real credentials.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact origin without trailing slash. Production callback:
# https://yaans.lk/api/auth/google/callback
# Local: http://localhost:5173 (register that origin's callback separately).
GOOGLE_LOGIN_ORIGIN=https://yaans.lk

# MongoDB Atlas or a local replica set. Transactions are required for writes.
# Database failures return errors; there is no local JSON/seed fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/yaans_lk
MONGODB_DB_NAME=yaans_lk

# Staging uses its own database user, APP_ENV=staging and MONGODB_DB_NAME=yaans_staging_lk.
# Writable Vercel previews refuse production database configuration.
MAINTENANCE_READ_ONLY=false

# Private operations checks only. Generate a separate random token of at least 32 characters.
MONITORING_TOKEN=

# Encrypted backups run from the private operations repository. Keep keys outside this repository.
BACKUP_PUBLIC_KEY_FILE=

# Cloudinary Product Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=yaans_lk/products

# Future Payment Gateway Preparation (PayHere / Stripe / LankaQR)
PAYMENT_GATEWAY_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# Order documents and Resend confirmation emails (disabled until verified)
DOCUMENT_BUSINESS_NAME=Yaans.lk
DOCUMENT_BUSINESS_ADDRESS=
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
ORDER_EMAIL_FROM=
ORDER_EMAIL_ENABLED=false
# Separate random >=32 character secret; also configure GitHub worker secret and opt-in variable.
ORDER_EMAIL_WORKER_SECRET=
