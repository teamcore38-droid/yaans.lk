# Yaans.lk Backend Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=yaans_lk_sri_lanka_marketplace_jwt_secret_2026

# MongoDB Connection (Supports MongoDB Atlas, AWS DocumentDB, or Local MongoDB)
# If unreachable in local dev, automatically falls back to persistent local document store (backend/data/yaans_db.json)
MONGODB_URI=mongodb://127.0.0.1:27017/yaans_lk

# Cloudinary Product Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=yaans_lk/products

# Future Payment Gateway Preparation (PayHere / Stripe / LankaQR)
PAYMENT_GATEWAY_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
